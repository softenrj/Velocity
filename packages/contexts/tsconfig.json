{
    "extends": "../../_tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "jsx": "react-jsx",
        "lib": [
            "DOM",
            "ES2022"
        ],
        "allowImportingTsExtensions": true,
        "strict": true,
        "noEmit": true,
        "moduleResolution": "bundler"
    },
    "include": [
        "context/*",
        "hooks/*"
    ]
}